<mjml>
  <mj-head>
    <mj-include path="../styles/base.mjml" />
    <mj-preview>Reset your password</mj-preview>
    <mj-title>Password Reset</mj-title>
  </mj-head>
  <mj-body background-color="#f3f4f6">
    <mj-include path="../components/header.mjml" />

    <mj-section padding="32px">
      <mj-column background-color="#ffffff" border-radius="8px" padding="32px">
        <mj-text font-size="22px" font-weight="700" letter-spacing="-0.03em" align="center">
          Reset your password
        </mj-text>
        <mj-spacer height="8px" />
        <mj-text font-size="15px" color="#4b5563" align="center" line-height="1.7">
          We received a request to reset the password for your account. Click the button below to set a new one. This link expires in <strong>1 hour</strong>.
        </mj-text>
        <mj-spacer height="16px" />
        <mj-button href="{{ reset_url }}" align="center">
          Reset Password
        </mj-button>
        <mj-spacer height="16px" />
        <mj-divider />
        <mj-text font-size="13px" color="#9ca3af" align="center">
          If you didn't request this, you can safely ignore this email.
        </mj-text>
        <mj-text font-size="13px" color="#9ca3af" align="center">
          Or paste this link into your browser: {{ reset_url }}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="../components/footer.mjml" />
  </mj-body>
</mjml>
